<Window x:Class="MmiConverter.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Third-Party Licenses" Width="600" Height="530" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}"
            CornerRadius="18" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Third-Party Licenses" FontWeight="SemiBold" FontSize="24"
                           Margin="24,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource CloseCaption}" Content="&#xE8BB;"
                        ToolTip="Close" AutomationProperties.Name="Close" Click="OnClose" />
            </Grid>
            <TextBox x:Name="LicenseText" Grid.Row="1" Margin="24,0,24,16" IsReadOnly="True"
                     AutomationProperties.Name="License notices and source information"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            <Grid Grid.Row="2" Margin="24,0,24,24">
                <TextBlock x:Name="SaveStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,278,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save FFmpeg source…" Style="{StaticResource AppButtonStyle}" MinHeight="40" Click="OnSaveSource" />
                    <Button Content="Close" Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" MinHeight="40"
                            Margin="10,0,0,0" IsDefault="True" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
