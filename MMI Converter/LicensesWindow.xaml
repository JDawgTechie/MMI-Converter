<Window x:Class="MmiConverter.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Third-party licenses" Width="600" Height="530" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}"
            CornerRadius="18" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Third-party licenses" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Top" />
            <TextBox x:Name="LicenseText" Grid.Row="1" Margin="0,8,0,16" IsReadOnly="True"
                     AutomationProperties.Name="License notices and source information"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            <Grid Grid.Row="2">
                <TextBlock x:Name="SaveStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,278,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save FFmpeg source…" Style="{StaticResource AppButtonStyle}" MinHeight="40" Click="OnSaveSource" />
                    <Button Content="Close" Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" MinHeight="40"
                            Margin="10,0,0,0" IsDefault="True" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
