<Window x:Class="MmiConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MMI Converter" Icon="Assets/MmiConverter.ico"
        Width="875" Height="580" MinWidth="740" MinHeight="500"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        PreviewDragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnWindowKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="{DynamicResource QuietButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="{DynamicResource QuietButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaption" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#9E2117" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="{DynamicResource QuietButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="QueueRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="37" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource QuietButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RaisedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Active}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QualitySlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource AccentBrush}">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                        <Border Height="6" CornerRadius="3,0,0,3" Background="{TemplateBinding Background}" />
                                    </ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="{DynamicResource LineBrush}">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                        <Border Height="6" CornerRadius="0,3,3,0" Background="{TemplateBinding Background}" />
                                    </ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="22" Height="24" Cursor="Hand">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Ellipse Width="20" Height="20" Fill="{DynamicResource InkBrush}"
                                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                        </Grid>
                                    </ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SwitchTrack" CornerRadius="13" Background="{DynamicResource QuietButtonBrush}"
                            BorderBrush="{DynamicResource QuietButtonBorderBrush}" BorderThickness="1">
                        <Ellipse x:Name="SwitchKnob" Width="18" Height="18" Margin="3,0" HorizontalAlignment="Left"
                                 Fill="{DynamicResource MutedBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SwitchKnob" Property="Fill" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowFrame" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}"
            CornerRadius="18" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="44" />
                    <ColumnDefinition Width="44" /><ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="MMI Converter" Margin="24,0,0,0" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource CaptionButton}" FontSize="15"
                        Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" Click="OnSettings" />
                <Button Grid.Column="2" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="OnMinimize" />
                <Button x:Name="MaximizeButton" Grid.Column="3" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="OnMaximize" />
                <Button Grid.Column="4" Style="{StaticResource CloseCaption}" Content="&#xE8BB;"
                        ToolTip="Close" AutomationProperties.Name="Close" Click="OnClose" />
                <Button x:Name="InformationButton" Grid.ColumnSpan="5" Visibility="Collapsed" Style="{StaticResource CaptionButton}"
                        FontFamily="Segoe UI" FontWeight="Bold" Content="i" FontSize="12" Width="22" Height="22"
                        Margin="0,0,24,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="2"
                        AutomationProperties.Name="Third-party licenses" ToolTip="Third-party licenses" Click="OnLicenses">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1"
                                CornerRadius="11" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource RaisedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource RaisedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Button.Template>
                </Button>
            </Grid>
            <Grid x:Name="MainPage" Grid.Row="1" Margin="24,0,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" />
                    <RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenButton" Style="{StaticResource AppButtonStyle}" Content="_Open MMI" Height="40"
                                MinWidth="108" Click="OnOpen" />
                        <Button x:Name="RemoveButton" Style="{StaticResource AppButtonStyle}" Content="_Remove" Height="40"
                                MinWidth="100" Margin="10,0,0,0" Click="OnRemove" IsEnabled="False" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" Padding="16,0,31,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <TextBlock Text="File" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Original size" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="Estimated new size" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="Queue" Grid.Row="1" Padding="0" BorderThickness="0" Background="Transparent"
                                 SelectionMode="Extended" SelectionChanged="OnSelection" ItemContainerStyle="{StaticResource QueueRow}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 AutomationProperties.Name="MMI conversion queue">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding OriginalText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding EstimateText}" ToolTip="{Binding Detail}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="DropHint" Grid.Row="1" Margin="16" Text="Drop MMI files here or choose Open MMI"
                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <Grid Grid.Row="4">
                    <TextBlock x:Name="StatusText" Text="Converted discs are saved beside their source files" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,250,0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Estimated space saved" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="SavingsText" Text="—" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="6" Style="{StaticResource Panel}" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="JPEG quality" FontWeight="SemiBold" />
                        <TextBlock x:Name="QualityValue" Text="94" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <Slider x:Name="Quality" Grid.Row="1" Style="{StaticResource QualitySlider}" Margin="0,5,0,1"
                                Minimum="80" Maximum="100" Value="94" TickFrequency="1" IsSnapToTickEnabled="True"
                                Height="24" SmallChange="1" LargeChange="1" IsMoveToPointEnabled="True"
                                AutomationProperties.Name="JPEG quality" ValueChanged="OnQuality" />
                        <Grid Grid.Row="2" Margin="10,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="14*" /><ColumnDefinition Width="6*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="80" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="100" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="1" Text="94" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" Width="120" TextAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock.RenderTransform><TranslateTransform X="-60" /></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="ProgressArea" Margin="0,0,20,0" Visibility="Hidden" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="ProgressText" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,55,0" />
                            <TextBlock x:Name="PercentText" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar x:Name="FileProgress" Style="{StaticResource AppProgressBar}" Maximum="100"
                                     AutomationProperties.Name="Current disc progress" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Style="{StaticResource AppButtonStyle}" Content="_Cancel" Visibility="Collapsed"
                                MinWidth="100" Height="40" Margin="0,0,10,0" Click="OnCancel" />
                        <Button x:Name="ConvertButton" Style="{StaticResource PrimaryButtonStyle}" Content="_Convert" MinWidth="112"
                                Height="40" Click="OnConvert" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid x:Name="SettingsPage" Grid.Row="1" Margin="24,0,24,24" Visibility="Collapsed">
                <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="134" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="ThemeText" Text="Dark" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <ToggleButton x:Name="ThemeToggle" Style="{StaticResource ThemeSwitch}" AutomationProperties.Name="Dark appearance"
                                          Click="OnTheme" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Rectangle Grid.RowSpan="2" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Fill="Transparent" Cursor="SizeNESW" Panel.ZIndex="4" shell:WindowChrome.ResizeGripDirection="BottomLeft" />
            <Rectangle Grid.RowSpan="2" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Fill="Transparent" Cursor="SizeNWSE" Panel.ZIndex="4" shell:WindowChrome.ResizeGripDirection="BottomRight" />
        </Grid>
    </Border>
</Window>
