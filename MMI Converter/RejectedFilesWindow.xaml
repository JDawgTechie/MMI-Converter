<Window x:Class="MmiConverter.RejectedFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MMI Files Only" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}"
            CornerRadius="18" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="MMI Files Only" FontWeight="SemiBold" FontSize="24"
                           Margin="24,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource CloseCaption}" Content="&#xE8BB;"
                        ToolTip="Close" AutomationProperties.Name="Close" Click="OnClose" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="24,0,24,24">
                <TextBlock x:Name="Explanation" Margin="0,0,0,14" TextWrapping="Wrap" />
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Files that were not opened">
                        <ItemsControl x:Name="RejectedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="12,8">
                                        <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <Button Content="OK" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"
                        MinWidth="92" MinHeight="40" Margin="0,16,0,0" IsDefault="True" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
